{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/run.mjs\" cursor",
        "timeout": 15
      }
    ],
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/run.mjs\" cursor",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/run.mjs\" cursor",
        "timeout": 15
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/run.mjs\" cursor",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/run.mjs\" cursor",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
